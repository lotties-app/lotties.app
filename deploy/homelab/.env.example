# Copy to deploy/homelab/.env (gitignored) and fill in. deploy.sh reads it as KEY=value lines (nothing is executed);
# a variable set in the shell wins over this file. The repository root .env (docker compose) is not used here.
# Placeholders only: never commit real values.

# --- Where to deploy (these are the defaults) ---
# REGISTRY=cr.homel4b.dev/lotties
# KUBE_CONTEXT=home-lab-main
# NS=lotties-app-production
# PUBLIC_HOST=lotties.app
# INGRESS_CLASS=traefik-external
# CLUSTER_ISSUER=letsencrypt-production-lotties-app-issuer
# TLS_SECRET=lotties-tls

# --- Identity provider (Keycloak realm lotties.app at https://auth.lotties.app); defaults shown ---
# AUTH_AUTHORITY=https://auth.lotties.app/realms/lotties.app
# AUTH_AUDIENCE=lotties-api

# --- Web build arguments: public, baked into the JavaScript bundle (a change rebuilds the web image) ---
# Required: the public SPA client id of the realm.
VITE_OIDC_CLIENT_ID=<spa-client-id>
# Default: AUTH_AUTHORITY. Its origin is allowed in the CSP connect-src.
# VITE_OIDC_AUTHORITY=
# Keycloak: leave empty (an audience mapper puts lotties-api in the token). Auth0: the API identifier.
# VITE_OIDC_AUDIENCE=
# Leave empty: same origin (the Ingress sends /api to the API).
# VITE_API_BASE_URL=
# Source repository link in the landing footer (AGPL source offer); empty hides it.
# VITE_REPO_URL=https://github.com/<owner>/<repository>

# --- Database (the Secret lotties-secrets). A key left out keeps what the Secret already has; set to empty to remove it ---
DB_HOST=<postgres-host>
DB_PORT=5432
DB_NAME=lotties
DB_APP_USER=<app-role>
DB_APP_PASSWORD=<app-role-password>

# Opt-in: the API applies pending migrations at start with the migrator role. The pod then holds the migrator
# credentials (see README.md "Migrations"). Default false.
# DB_AUTO_MIGRATE=false
# DB_MIGRATOR_USER=<migrator-role>
# DB_MIGRATOR_PASSWORD=<migrator-role-password>

# --- Web Push (optional): all three or none. Generate a pair once: dotnet run --project code/api/src/Lotties.Api -- --generate-vapid-keys
# PUSH_VAPID_PUBLIC_KEY=<public-key>
# PUSH_VAPID_PRIVATE_KEY=<private-key>
# PUSH_VAPID_SUBJECT=mailto:<operator@example.com>

# --- Proxies whose X-Forwarded-For/-Proto the API trusts (CIDR list). Default: the private ranges, which cover the pod network ---
# FORWARDED_HEADERS_TRUSTED_NETWORKS=10.42.0.0/16

# --- Browser origins allowed to call the API (comma-separated). Default: https://<PUBLIC_HOST> only ---
# The iOS/Android app (code/mobile) calls the API from its WebView origins: add them when it ships.
# CORS_ALLOWED_ORIGINS=https://lotties.app,https://localhost,capacitor://localhost

# --- Build options ---
# TAG=
# FORCE_BUILD=1
# SKIP_BUILD=1
# VERSION=1.0.0
# COPY_PULL_SECRET=1
