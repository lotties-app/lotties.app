{
  "name": "baby-routine-keycloak-theme",
  "version": "0.2.0",
  "private": true,
  "description": "Keycloak login theme for Lotties (Keycloakify 11)",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host --port 5190",
    "sync-tokens": "tsx scripts/sync-tokens.ts",
    "build": "tsc && vite build",
    "build-keycloak-theme": "npm run build && keycloakify build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "podman:build": "bash ./build-in-podman.sh",
    "dev:flows": "node dev/flows/run-flows.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "keycloakify": "^11.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
