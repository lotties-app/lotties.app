# Builds the Keycloak theme jar(s) without Java or Maven on the host.
#   bash build-in-podman.sh        (or keycloak-theme/build-in-podman.ps1 on Windows)
FROM docker.io/library/node:22-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends maven default-jdk-headless \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN npm ci

COPY . .
# KC_TARGETS=all also builds the jars for Keycloak 22 to 25 (default: one jar for "all other versions").
ARG KC_TARGETS=
ENV KC_TARGETS=${KC_TARGETS}
RUN npm run build-keycloak-theme
