# Copy to .env and replace the placeholders. Never commit .env.

# API database connection (read by the api container)
# Use "postgres" when running with --profile localdb, otherwise your database host.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=babyroutine
DB_APP_USER=baby_app
DB_APP_PASSWORD=change-me

# Superuser for the optional localdb postgres container only
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# API authentication: any OIDC provider (Auth0, Keycloak, Authentik, ...).
# Required outside Development. Authority is the issuer URL, Audience the API identifier tokens must carry.
AUTH_AUTHORITY=https://your-tenant.example.com/
AUTH_AUDIENCE=https://api.babyroutine.example.com

# Comma-separated browser origins allowed to call the API (the web app URL).
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
