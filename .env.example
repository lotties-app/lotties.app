# Copy to .env and replace the placeholders. Never commit .env. See docs/DEPLOY.md.
# Read by docker compose (both for the containers and for the web build arguments).

# --- API database connection (api container) ---
# External database: its host name. With `--profile localdb` use "postgres".
DB_HOST=postgres
DB_PORT=5432
DB_NAME=babyroutine
# Limited application role (SELECT/INSERT/UPDATE/DELETE only), see docs/DEPLOY.md.
DB_APP_USER=baby_app
DB_APP_PASSWORD=change-me

# --- Database migrations (optional), see docs/DEPLOY.md "Applying migrations" ---
# true = the api applies pending EF Core migrations at startup (development/self-hosting convenience).
# Default false: apply them with `dotnet ef database update` as the migrator role instead.
DB_AUTO_MIGRATE=false
# Role with DDL rights used for migrations; leave empty to fall back to DB_APP_USER/DB_APP_PASSWORD
# (fine with --profile localdb, where that user is the superuser). Only needed by the api when DB_AUTO_MIGRATE=true.
DB_MIGRATOR_USER=
DB_MIGRATOR_PASSWORD=

# --- Optional local PostgreSQL (docker compose --profile localdb) ---
# Password of the superuser created in the container; the user name is DB_APP_USER, so set this to
# the same value as DB_APP_PASSWORD. There is no default: the container will not start without it.
# The port is bound to 127.0.0.1 only.
POSTGRES_PASSWORD=change-me

# --- API authentication: any OIDC provider (Auth0, Keycloak, Authentik, ...) ---
# Required outside Development. Authority is the issuer URL, Audience the API identifier tokens must carry.
AUTH_AUTHORITY=https://your-tenant.example.com/
AUTH_AUDIENCE=https://api.babyroutine.example.com

# Comma-separated browser origins allowed to call the API. Not needed with the default compose
# setup (same origin through nginx); set it only if the web app is served from another origin.
CORS_ALLOWED_ORIGINS=

# --- Optional push notifications (Web Push, VAPID); see docs/DEPLOY.md "Push notifications" ---
# Leave all three empty to keep push off; set all three to enable it (partial = startup error).
# Generate a pair with: dotnet BabyRoutine.Api.dll --generate-vapid-keys  (the private key is a secret)
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
# Operator contact: mailto: address or https: URL.
PUSH_VAPID_SUBJECT=

# --- Web build arguments (baked into the SPA bundle at `docker compose build`; public values) ---
# Public SPA client id registered at the OIDC provider (application type: SPA).
VITE_OIDC_CLIENT_ID=
# Issuer URL; same value as AUTH_AUTHORITY. Its origin is also allowed in the CSP connect-src.
VITE_OIDC_AUTHORITY=https://your-tenant.example.com/
# API audience, sent as the "audience" authorize parameter (Auth0 API identifier); same as AUTH_AUDIENCE.
VITE_OIDC_AUDIENCE=https://api.babyroutine.example.com
# Leave empty: the SPA calls /api on its own origin and nginx proxies it to the api container.
VITE_API_BASE_URL=

# Host port the web container is published on.
WEB_PORT=8080
