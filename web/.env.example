# Copy to .env.local and fill in. Any OIDC provider works (authorization code + PKCE).
# Base URL of the API (empty string = same origin, e.g. behind a reverse proxy)
VITE_API_BASE_URL=http://localhost:8080
# Issuer URL of the OIDC provider
#   Auth0:    https://YOUR_TENANT.eu.auth0.com/
#   Keycloak: http://localhost:8081/realms/baby-routine
VITE_OIDC_AUTHORITY=
# Public (SPA) client id registered at the provider
VITE_OIDC_CLIENT_ID=
# Optional: API audience, sent as the "audience" authorize parameter (e.g. Auth0 API identifier)
VITE_OIDC_AUDIENCE=
