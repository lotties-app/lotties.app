<?xml version="1.0" encoding="utf-8"?>
<!--
  Android voice entry points (docs/design/37-widgets-siri.md section 14). Same ids as VoiceCatalog.FEATURE_IDS.
  - Static launcher shortcuts (long-press the app icon, or drag one to the home screen): each starts the non-exported
    .voice.VoiceActivity with the extra `feature` = the shortcut id; VoiceCatalog.feature maps it to an MCP tool.
  - Google Assistant App Actions: built-in intent actions.intent.OPEN_APP_FEATURE with these shortcuts as its inline
    inventory (capability-binding; the synonyms are arrays in values/voice_strings.xml). Assistant sends the matched
    shortcut id as the extra `feature` to the exported alias .voice.VoiceAssistantEntry. Needs a Play Console release
    and Google's review; not verified on a device.
  Labels must be @string resources.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:targetApi="25">

    <capability android:name="actions.intent.OPEN_APP_FEATURE">
        <intent
            android:action="app.lotties.app.VOICE"
            android:targetPackage="app.lotties.app"
            android:targetClass="app.lotties.app.voice.VoiceAssistantEntry">
            <parameter
                android:name="feature"
                android:key="feature" />
        </intent>
    </capability>
    <shortcut
        android:shortcutId="diaper_wet"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/voice_shortcut_diaper_wet_short"
        android:shortcutLongLabel="@string/voice_shortcut_diaper_wet_long">
        <intent
            android:action="app.lotties.app.VOICE"
            android:targetPackage="app.lotties.app"
            android:targetClass="app.lotties.app.voice.VoiceActivity">
            <extra
                android:name="feature"
                android:value="diaper_wet" />
        </intent>
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding
                android:key="feature"
                android:value="@array/voice_feature_diaper_wet" />
        </capability-binding>
    </shortcut>
