<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device through Android backup or device-to-device transfer: the WebView storage holds the
     sign-in refresh token and the unsynced outbox. Everything else comes back from the server after sign-in
     (docs/design/12-mobile-capacitor.md section 6). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
