<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lotties.Domain\Lotties.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Part-of-the-day vectors shared with the web port (code/web/src/medications/dayParts.test.ts). -->
    <None Include="..\..\..\web\src\medications\dayPartVectors.json" Link="Prescriptions\dayPartVectors.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Bottle segments vectors shared with the web port (code/web/src/events/bottleSegments.test.ts). -->
    <None Include="..\..\..\web\src\events\bottleSegmentsVectors.json" Link="Events\bottleSegmentsVectors.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Vaccine status vectors shared with the web port (code/web/src/vaccines/vaccineStatus.test.ts) and the shipped schedule. -->
    <None Include="..\..\..\web\src\vaccines\vaccineStatusVectors.json" Link="Vaccinations\vaccineStatusVectors.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\vaccine-schedule.br.json" Link="Vaccinations\vaccine-schedule.br.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Published age norms (docs/design/28-age-norms.md), validated by AgeNorms/AgeNormsDataTests (embedded in Lotties.Application),
         and the lookup vectors shared with the web port (code/web/src/ageNorms/ageNorms.test.ts). -->
    <None Include="..\..\data\age-norms.json" Link="AgeNorms\age-norms.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\web\src\ageNorms\ageNormsVectors.json" Link="AgeNorms\ageNormsVectors.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
