<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Lotties.Domain\Lotties.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lotties.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The vaccine schedule (docs/design/18-vaccines.md): one source of truth in code/api/data, shipped inside this assembly.
         WithCulture="false": ".br" in the name is the country (Brazil), not the Breton culture (no satellite assembly). -->
    <EmbeddedResource Include="..\..\data\vaccine-schedule.br.json" LogicalName="Lotties.Application.Vaccinations.vaccine-schedule.br.json" WithCulture="false" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
