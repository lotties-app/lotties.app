# Local development only: copy to .env.local and fill in. (Docker builds take these values
# from the repo-root .env through compose build args; see docs/DEPLOY.md.)
# Any OIDC provider works (authorization code + PKCE).

# Base URL of the API.
# Dev with the .NET API running on the host (dotnet run, default Kestrel port 5000): the API must
# list http://localhost:5173 in CORS_ALLOWED_ORIGINS.
# Alternative without CORS: leave this empty and add a Vite dev proxy
# (server.proxy: { '/api': 'http://localhost:5000' } in vite.config.ts) so /api is same origin.
# Docker / production: empty (same origin, nginx proxies /api/).
VITE_API_BASE_URL=http://localhost:5000
# Issuer URL of the OIDC provider
#   Auth0:    https://YOUR_TENANT.eu.auth0.com/
#   Keycloak: http://localhost:8081/realms/lotties.app
VITE_OIDC_AUTHORITY=
# Public (SPA) client id registered at the provider
VITE_OIDC_CLIENT_ID=
# Optional: API audience, sent as the "audience" authorize parameter (e.g. Auth0 API identifier)
VITE_OIDC_AUDIENCE=
# Optional: link to the source repository, shown in the landing page footer (hidden when empty).
# Must be an http(s) address. Build-time value, like the others.
VITE_REPO_URL=https://github.com/lotties-app/lotties.app
# Optional: "Report a problem" link (http/https). Empty = VITE_REPO_URL + /issues/new, else a mailto: to
# VITE_PRIVACY_CONTACT_EMAIL, else hidden.
VITE_ISSUES_URL=
# Optional: "Support Lotties" link (http/https only, opens in a new tab); empty hides it.
VITE_SUPPORT_URL=
# Optional "Get the phone app" beta links on the landing page (http/https only; docs/DEPLOY.md "Phone app links").
# Each empty one hides its card, step or button; all empty hides the section.
VITE_TESTFLIGHT_URL=
VITE_ANDROID_TESTERS_GROUP_URL=
VITE_ANDROID_OPTIN_URL=
VITE_PLAY_STORE_URL=
# Privacy policy (/privacy) contacts, published as typed (public values: never a secret). Empty = the
# policy's defaults ("the Lotties project maintainers", the GitHub issue tracker and private reports).
# Set all three before a store submission: docs/PRIVACY-OWNER-CHECKLIST.md.
#   Controller: the person or company responsible for the data, as it should be published.
VITE_PRIVACY_CONTROLLER_NAME=
#   Contact email for privacy requests (a plain address; it becomes a mailto: link).
VITE_PRIVACY_CONTACT_EMAIL=
#   Data protection contact (encarregado): a name, an email, or both.
VITE_PRIVACY_DPO=
