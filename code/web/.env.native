# Build values of the iOS/Android app (code/mobile): `npm run build:native` here, or `npm run build:web` in
# code/mobile, builds with Vite mode "native", which loads this file. Public values only (they are baked into the
# JavaScript bundle and committed): never put a secret here.
# Local overrides go in .env.native.local (gitignored). A variable set in the shell wins over both, for example
#   VITE_OIDC_CLIENT_ID=<spa-client-id> npm run build:web
# Vite also reads .env and .env.local in every mode: every key is listed here so none of their dev values leaks in.

# The app is served from its own bundle (https://localhost, capacitor://localhost), so the API is never same-origin:
# the production API, which lists those origins in CORS_ALLOWED_ORIGINS (docs/design/12-mobile-capacitor.md).
VITE_API_BASE_URL=https://lotties.app
# The production realm. Its client must list the app's redirect URIs and Web origins (same doc, section 4).
VITE_OIDC_AUTHORITY=https://auth.lotties.app/realms/lotties.app
# Required: the public client id of the realm. Set it in .env.native.local or in the shell (left empty here: the
# app shows its setup message instead of a broken sign-in).
VITE_OIDC_CLIENT_ID=
# Keycloak: empty (an audience mapper puts lotties-api in the token).
VITE_OIDC_AUDIENCE=
# Keycloak public client the iOS Siri/Shortcuts intents sign in with (docs/MCP.md "Siri on iOS"); not the app's client.
VITE_SIRI_CLIENT_ID=lotties-ios
# Keycloak public client the Android voice shortcuts sign in with (docs/MCP.md "Voice on Android"); not the app's client.
VITE_ANDROID_VOICE_CLIENT_ID=lotties-android
# Source link in the landing footer (AGPL source offer).
VITE_REPO_URL=https://github.com/lotties-app/lotties.app
# "Report a problem" (empty = VITE_REPO_URL + /issues/new) and "Support Lotties" (empty hides it): docs/DEPLOY.md.
VITE_ISSUES_URL=
VITE_SUPPORT_URL=
# The "Get the phone app" beta links (VITE_TESTFLIGHT_URL ...) are for the website only: the native app never shows that section.
# Privacy policy contacts (the same public values as the web build; empty = the policy's defaults). Set them in
# .env.native.local or the shell before a store build: docs/PRIVACY-OWNER-CHECKLIST.md.
VITE_PRIVACY_CONTROLLER_NAME=
VITE_PRIVACY_CONTACT_EMAIL=
VITE_PRIVACY_DPO=
